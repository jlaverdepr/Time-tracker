{
  "name": "desktop",
  "version": "0.0.0",
  "private": true,
  "main": "dist-main/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:main": "node build/build-main.mjs",
    "build": "pnpm run build:main && electron-builder --config electron-builder.yml",
    "build:main:beta": "APP_CHANNEL=beta node build/build-main.mjs",
    "build:beta": "pnpm run build:main:beta && electron-builder --config electron-builder.beta.yml"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "0.27.3"
  }
}
